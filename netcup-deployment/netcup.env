
# Helix Regulatory Intelligence - Netcup Environment Configuration

# Database Configuration (PostgreSQL on Netcup)
DATABASE_URL=postgresql://helix_user:secure_helix_password@localhost:5432/helix_regulatory

# Application Configuration
NODE_ENV=production
PORT=5000
HOST=0.0.0.0

# Session Management
SESSION_SECRET=your-very-secure-session-secret-here-min-32-chars

# Cache Configuration (Redis on Netcup)
REDIS_URL=redis://localhost:6379

# API Keys (Configure these with your actual keys)
ANTHROPIC_API_KEY=your_anthropic_key_here
FDA_API_KEY=your_fda_key_here
EMA_API_KEY=your_ema_key_here

# Email Configuration (Optional)
SENDGRID_API_KEY=your_sendgrid_key_here
SMTP_HOST=your_smtp_host
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password

# Logging
LOG_LEVEL=info
LOG_FILE=/var/www/helix/logs/helix.log

# Security
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com
RATE_LIMIT=1000

# Netcup Specific
SERVER_NAME=your-server.netcup.net
SSL_CERT_PATH=/etc/ssl/certs/helix.crt
SSL_KEY_PATH=/etc/ssl/private/helix.key
